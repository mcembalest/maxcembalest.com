---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { getNotes } from '../../lib/notes.ts'

export async function getStaticPaths() {
  const notes = await getNotes()
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }))
}

const { note } = Astro.props
const { Content } = await render(note)
const date = note.data.date?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
---

<Base title={note.data.title} description={note.data.description}>
  <p class="muted"><a href="/notes">← Notes</a></p>
  <h1>{note.data.title}</h1>
  {date && <p class="muted">{date}</p>}
  <Content />
</Base>
