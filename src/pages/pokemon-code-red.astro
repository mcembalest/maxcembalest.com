---
import Thing from '../layouts/Thing.astro'
import '../things/pokemon-code-red/player.css'
---

<Thing slug="pokemon-code-red">
  <section class="code-red" data-code-red>
    <div data-open hidden>
      <p class="muted">Open your FireRed USA v1.0 file once. It stays on this device.</p>
      <button class="code-red-button" data-choose type="button">Open FireRed file</button>
      <input data-file type="file" accept=".gba,application/octet-stream" hidden />
    </div>
    <p class="code-red-status" data-status role="status" aria-live="polite">Loading…</p>
    <p class="code-red-error" data-error role="alert" hidden></p>
    <p class="muted">PC Code opens a JavaScript scratchpad. Type game names in the name field; tap it for your phone keyboard. Click the game to use arrows. Hold Space for 10× speed; release to return to normal. Click outside to use page keys.</p>
    <div id="code-red-game" class="code-red-game" data-game hidden aria-label="Code Red game player"></div>
    <div class="code-red-save" data-save-bar hidden>
      <button class="code-red-button" data-save type="button" disabled>Save</button>
      <small class="muted">On this browser only. Export a backup from the game menu. This PC-menu update starts a new save slot. Earlier local saves remain stored; use the earlier build to access them. Do not import earlier ROM/core states here.</small>
    </div>
    <p class="code-red-credit"><a href="/code-red-emulator/SOURCES.txt">EmulatorJS</a> · <a href="/code-red-emulator/LICENSE">License</a> · <a href="/code-red-emulator/code-red-source/README.md">Custom core sources</a></p>
    <noscript><p>JavaScript is needed to play.</p></noscript>
  </section>
</Thing>

<script>
  import { mount } from '../things/pokemon-code-red/player'
  mount(document.querySelector<HTMLElement>('[data-code-red]')!)
</script>
