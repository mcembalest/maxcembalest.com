const external = (href?: string) => !!href && /^https?:/.test(href)
const lastName = (name: string) => name.split(' ').at(-1)
---

<Base title="CV" description="CV of Max Cembalest." fit>
  <h1 class="visually-hidden">CV</h1>

  <div class="cv">
    <div class="column summary">
      <h2 id="education">Education</h2>

      <p>
        <strong>Harvard University</strong>, MS in Data Science <span class="muted">· 2022</span><br />
        <strong>Wesleyan University</strong>, BA in Mathematics and Computer Science, Phi Beta Kappa
        <span class="muted">· 2018</span>
      </p>

      <h2 id="publications">Publications</h2>

      {
        publications.map((pub) => (
          <p class="publication">
            {pub.page ? <a href={pub.page}>{pub.title}</a> : pub.title}
            <br />
            <span class="muted">
              {/* Kept on one line: line breaks here would render as spaces before the commas. */}
              {pub.authors.map((author, i) => <>{i > 0 && ', '}{author === me ? <strong>{lastName(author)}</strong> : lastName(author)}</>)}. <em>{pub.venue}</em>. <a href={pub.paper}>arXiv</a>
            </span>
          </p>
        ))
      }

      <h2 id="work-experience">Work Experience</h2>

      {
        jobs.map((job) => (
          <div class="job">
            <h3>
              {job.title} · {job.company} <span class="muted">· {job.dates}</span>
            </h3>
            <p>{job.summary}</p>
          </div>
        ))
      }
    </div>

    <div class="column">
      <h2 id="projects">Projects</h2>

      {
        projects.map(({ year, rows }) => (
          <section class="year">
            <h3>{year}</h3>
            {rows.map((row) => {
              const Tag = row.href ? 'a' : 'div'
              return (
                <Tag class="row" href={row.href}>
                  <div class="thumb">
                    {row.image && <Image src={row.image} alt="" width={500} />}
                    {row.video && (
                      <video data-autoplay muted loop playsinline preload="none" poster={`/media/thumbs/${row.video}.jpg`}>
                        <source src={`/media/thumbs/${row.video}.mp4`} type="video/mp4" />
                      </video>
                    )}
                  </div>
                  <div>
                    <strong class="title">
                      {row.title}
                      {external(row.href) && <span class="muted"> ↗</span>}
                    </strong>
                    <p class="muted">{row.text}</p>
                  </div>
                </Tag>
              )
            })}
          </section>
        ))
      }
    </div>
  </div>

  <dialog class="project" aria-label="Project">
    <div class="bar">
      <a data-full-page href="">Open as page</a>
      <button type="button" data-close aria-label="Close">✕</button>
    </div>
    <article data-content></article>
  </dialog>
</Base>

<script>
  // Play thumbnail clips only while they're on screen, and not at all for people who prefer less motion.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement
          if (entry.isIntersecting) video.play().catch(() => {})
          else video.pause()
        }
      },
      { threshold: 0.5 },
    )
    document.querySelectorAll('video[data-autoplay]').forEach((video) => observer.observe(video))
  }

  // Project pages open in a modal. The URL changes to the project's own address, so the link
  // can be shared, a reload shows the full page, and Back closes the modal.
  const dialog = document.querySelector<HTMLDialogElement>('dialog.project')!
  const content = dialog.querySelector<HTMLElement>('[data-content]')!
  const fullPage = dialog.querySelector<HTMLAnchorElement>('[data-full-page]')!
  const cvUrl = location.pathname
  const cvTitle = document.title
  const cache = new Map<string, Promise<Document>>()

  const load = (path: string) => {
    if (!cache.has(path)) {
      cache.set(
        path,
        fetch(path)
          .then((r) => r.text())
          .then((html) => new DOMParser().parseFromString(html, 'text/html')),
      )
    }
    return cache.get(path)!
  }

  async function show(path: string) {
    const page = await load(path)
    const main = page.querySelector('main')!
    // The page's own "← CV" link is redundant inside the modal.
    main.querySelector('a[href="/cv"]')?.closest('p')?.remove()
    content.replaceChildren(...Array.from(main.cloneNode(true).childNodes))
    fullPage.href = path
    document.title = page.title
    if (!dialog.open) dialog.showModal()
    dialog.scrollTop = 0
  }

  const isProjectLink = (a: HTMLAnchorElement) => a.origin === location.origin && /^\/cv\/\d{4}\//.test(a.pathname)

  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
    const a = (e.target as Element).closest('a')
    if (!a || dialog.contains(a) || !isProjectLink(a)) return
    e.preventDefault()
    history.pushState({ project: a.pathname }, '', a.pathname)
    show(a.pathname).catch(() => (location.href = a.pathname))
  })

  // Prefetch on hover so the modal opens instantly.
  document.addEventListener('pointerover', (e) => {
    const a = (e.target as Element).closest?.('a')
    if (a && isProjectLink(a)) load(a.pathname)
  })

  // Closing by Esc, the ✕ button, or the backdrop goes back to the CV's address.
  dialog.addEventListener('close', () => {
    document.title = cvTitle
    if (history.state?.project) history.back()
  })
  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close())
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close()
  })
  window.addEventListener('popstate', () => {
    const project = history.state?.project
    if (project) show(project)
    else if (dialog.open && location.pathname === cvUrl) {
      document.title = cvTitle
      dialog.close()
    }
  })
</script>

<style>
  h2 {
    margin: 0 0 0.6rem;
    font-size: 1rem;
  }

  .column > h2:not(:first-child) {
    margin-top: 1.25rem;
  }

  .summary {
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .summary p {
    margin-bottom: 0.6rem;
  }

  .job h3 {
    margin: 0.75rem 0 0.15rem;
    font-size: 0.9rem;
  }

  .job p {
    margin-bottom: 0;
  }

  .year h3 {
    margin: 1.5rem 0 0.6rem;
    color: var(--muted);
  }

  .year:first-of-type h3 {
    margin-top: 0;
  }

  .row {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 0.75rem;
    margin-bottom: 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
  }

  a.row {
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  a.row:hover {
    border-color: var(--link);
    transform: translateY(-1px);
  }

  a.row:hover .title {
    text-decoration: underline;
  }

  .thumb {
    flex-shrink: 0;
    width: 120px;
    aspect-ratio: 5 / 3;
    overflow: hidden;
    border-radius: 4px;
    background: var(--rule);
  }

  .thumb :global(img),
  .thumb video {
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 0;
    object-fit: contain;
  }

  .title {
    display: block;
    font-size: 0.95rem;
    line-height: 1.35;
    margin-bottom: 0.2rem;
  }

  .row p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.45;
  }

  /* Desktop: two columns that exactly fill the space under the nav; each scrolls on its own if needed. */
  @media (min-width: 1000px) {
    .cv {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
      height: 100%;
    }

    .column {
      min-height: 0;
      overflow-y: auto;
      padding-right: 0.75rem;
      scrollbar-width: thin;
    }
  }

  @media (max-width: 999px) {
    .column + .column {
      margin-top: 2.5rem;
    }
  }

  .project {
    width: min(52rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 3rem);
    padding: 0 1.75rem 1.75rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 10px;
  }

  .project::backdrop {
    background: rgb(0 0 0 / 0.55);
  }

  .bar {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0 0.5rem;
    background: var(--bg);
    font-size: 0.9rem;
  }

  .bar button {
    font: inherit;
    font-size: 1.1rem;
    color: var(--muted);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .bar button:hover {
    color: var(--text);
  }

  .project :global(h1) {
    font-size: 1.5rem;
  }
</style>
