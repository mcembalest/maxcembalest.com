    authors: ['Benjamin Feuer', 'Micah Goldblum', 'Teresa Datta', 'Sanjana Nambiar', 'Raz Besaleli', 'Samuel Dooley', me, 'John P. Dickerson'],
    venue: 'ICLR 2025',
    page: '/cv/2025/style-outweighs-substance',
    paper: 'https://arxiv.org/abs/2409.15268',
  },
  {
